<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="/var/www/html/vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
    colors="true"
    failOnWarning="true"
    failOnRisky="true"
    displayDetailsOnIncompleteTests="true"
    displayDetailsOnSkippedTests="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerErrors="true"
    displayDetailsOnTestsThatTriggerNotices="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
>
    <testsuites>
        <testsuite name="Functional Tests">
            <directory suffix="Test.php">Tests/Functional</directory>
        </testsuite>
        <testsuite name="Unit Tests">
            <directory suffix="Test.php">Tests/Unit</directory>
        </testsuite>
    </testsuites>

    <php>
        <ini name="display_errors" value="1"/>
        <env name="typo3DatabaseUsername" value="db" />
        <env name="typo3DatabasePassword" value="db" />
        <env name="typo3DatabasePort" value="3306" />
        <env name="TYPO3_CONTEXT" value="Development/Local" />
        <env name="typo3DatabaseHost" value="db" />
        <env name="typo3DatabaseName" value="db" />
    </php>

</phpunit>


